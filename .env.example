# Copy to .env. Never commit the completed .env file or real credentials.

# Core application secrets
MONGO_URI=replace_with_client_managed_mongodb_uri
JWT_SECRET=replace_with_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_separate_long_random_secret

# Public frontend allowlist. Add more exact HTTPS origins as a comma-separated list.
CLIENT_URL=https://www.aslilearn.ai
CLIENT_URLS=https://aslilearn.ai,https://www.aslilearn.ai

# Payment provider
RAZORPAY_KEY_ID=replace_with_dashboard_key_id
RAZORPAY_KEY_SECRET=replace_with_dashboard_secret

# Maintenance scripts. Supply only when intentionally running the matching script.
ADMIN_EMAIL=admin@example.com
ADMIN_NEW_PASSWORD=replace_at_runtime_only
ADMIN_TEST_PASSWORD=replace_at_runtime_only
RECOVERY_ADMIN_PASSWORD=replace_at_runtime_only

# Optional Python compatibility server. Use 0.0.0.0 only behind an approved firewall/proxy.
PYTHON_API_HOST=127.0.0.1
PYTHON_API_PORT=8000
