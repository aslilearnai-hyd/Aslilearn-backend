{
  "name": "asli-stud-backend",
  "version": "1.0.0",
  "description": "Backend API for Asli Stud educational platform",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=3072 index.js",
    "start:ollama": "bash start-with-ollama.sh",
    "dev": "nodemon index.js",
    "build": "echo 'No build step required'",
    "postinstall": "echo 'Dependencies installed successfully'",
    "super-admin": "node start-super-admin.js",
    "test-super-admin": "node test-super-admin.js",
    "server": "node index.js",
    "dev-server": "nodemon index.js",
    "server:minimal": "node server.js",
    "fix-user": "node fix-user-login.js",
    "seed:ai-topics:class10-cbse": "node scripts/seed-ai-tool-topics-class10-cbse.js",
    "seed:hindi-ai-topics-ncert": "node scripts/seed-hindi-ai-tool-topics-ncert-data.js",
    "migrate:ai-tool-board-cbse": "node scripts/migrate-ai-tool-board-to-cbse.js",
    "test:pdf-extraction": "node tests/pdf-extraction/run-all.js",
    "test:security": "node --test tests/security-regression.test.js",
    "test:observability": "node --test tests/observability.test.js",
    "test:auth": "node --test tests/auth-middleware.test.js tests/auth-cookie.test.js",
    "test:http": "node --test tests/http-smoke.test.js",
    "test:ai-layout": "node --test tests/ai-platform-layout.test.js",
    "test:metrics": "node --test tests/metrics.test.js",
    "test:maturity": "node --test tests/security-regression.test.js tests/observability.test.js tests/auth-middleware.test.js tests/auth-cookie.test.js tests/http-smoke.test.js tests/ai-platform-layout.test.js tests/metrics.test.js tests/teacher-vidya-routing.test.js tests/vidya-platform-data-firewall.test.js tests/vidya-call-log-meta.test.js tests/vidya-foundation.test.js",
    "test": "npm run test:maturity",
    "load:baseline": "echo Install k6 then: k6 run -e BASE_URL=http://127.0.0.1:5000 load/k6-baseline.js",
    "db:diagnose": "node scripts/diagnose-database.js",
    "db:rebuild-schools": "node scripts/rebuild-schools-from-admins.js",
    "db:restore-users": "node scripts/restore-core-users.js",
    "db:recover-orphans": "node scripts/recover-schools-from-orphans.js",
    "ai:fingerprint-backfill": "node scripts/ai-fingerprint-backfill.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@google/genai": "^2.15.0",
    "@google/generative-ai": "^0.24.1",
    "adm-zip": "^0.5.17",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.4.24",
    "ioredis": "^5.10.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
